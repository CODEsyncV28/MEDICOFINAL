{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile holding identity and assigned platform role (user, practitioner, admin).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Authentication UID." },
        "email": { "type": "string", "format": "email", "description": "User email address." },
        "displayName": { "type": "string", "maxLength": 80, "description": "User full name or display pseudonym." },
        "role": { "type": "string", "enum": ["user", "practitioner", "admin"], "description": "Authorized platform access tier." },
        "agreedToTerms": { "type": "boolean", "description": "Whether user agreed to health educational terms." },
        "assignedPractitionerId": { "type": "string", "description": "UID of supervising AYUSH doctor." },
        "prakritiBaseline": { "type": "string", "description": "Constitutional dosha baseline from assessment." },
        "createdAt": { "type": "string", "description": "ISO timestamp of registration." },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last profile update." }
      },
      "required": ["uid", "role", "agreedToTerms", "createdAt"]
    },
    "LifestyleAssessment": {
      "title": "LifestyleAssessment",
      "description": "Non-clinical self-observation questionnaire record assessing circadian and metabolic habits.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "Owning user UID." },
        "totalAnswered": { "type": "number", "description": "Number of answered questions." },
        "totalQuestions": { "type": "number", "description": "Total assessment questions." },
        "isComplete": { "type": "boolean" },
        "circadianBalanceCategory": { "type": "string", "maxLength": 100 },
        "digestiveAgniCategory": { "type": "string", "maxLength": 100 },
        "movementCategory": { "type": "string", "maxLength": 100 },
        "stressCategory": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "isComplete", "updatedAt"]
    },
    "DailyActivityLog": {
      "title": "DailyActivityLog",
      "description": "Daily check-in record for circadian Dinacharya rituals.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "Owning user UID." },
        "activityKey": { "type": "string", "maxLength": 80 },
        "dateString": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Calendar date (YYYY-MM-DD)." },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "userId", "activityKey", "dateString", "completed"]
    },
    "WellnessProgram": {
      "title": "WellnessProgram",
      "description": "Multi-week guided wellness regimen template authored by practitioners.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "discipline": { "type": "string", "enum": ["Ayurveda", "Yoga & Naturopathy", "Unani", "Siddha", "Homeopathy"] },
        "category": { "type": "string" },
        "durationWeeks": { "type": "number" },
        "totalSessions": { "type": "number" },
        "creatorPractitionerId": { "type": "string" },
        "practitionerName": { "type": "string" },
        "practitionerTitle": { "type": "string" },
        "description": { "type": "string", "maxLength": 1000 },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Deepening"] },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "discipline", "creatorPractitionerId", "isPublished"]
    },
    "EducationalArticle": {
      "title": "EducationalArticle",
      "description": "Peer-reviewed traditional wellness guide or educational article.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "discipline": { "type": "string" },
        "category": { "type": "string" },
        "readTime": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorQualification": { "type": "string" },
        "summary": { "type": "string", "maxLength": 500 },
        "fullContent": { "type": "string", "maxLength": 10000 },
        "status": { "type": "string", "enum": ["draft", "pending_approval", "published", "revision_requested"] },
        "publishedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "discipline", "authorId", "status", "summary"]
    },
    "PractitionerProfile": {
      "title": "PractitionerProfile",
      "description": "Verified credential profile for certified AYUSH physicians.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "qualification": { "type": "string", "maxLength": 100 },
        "discipline": { "type": "string" },
        "specialization": { "type": "string" },
        "experienceYears": { "type": "number" },
        "councilRegistration": { "type": "string", "maxLength": 120 },
        "isVerified": { "type": "boolean" },
        "activeClientsCount": { "type": "number" },
        "rating": { "type": "number" },
        "bio": { "type": "string", "maxLength": 800 },
        "nextAvailableSlot": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "qualification", "councilRegistration", "isVerified"]
    },
    "ConsultationRequest": {
      "title": "ConsultationRequest",
      "description": "Lifestyle consultation inquiry and scheduling request between seeker and practitioner.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "practitionerId": { "type": "string" },
        "practitionerName": { "type": "string" },
        "topic": { "type": "string", "maxLength": 120 },
        "preferredSlot": { "type": "string", "enum": ["morning", "afternoon", "evening"] },
        "notes": { "type": "string", "maxLength": 800 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "practitionerId", "topic", "status", "createdAt"]
    },
    "ContentApproval": {
      "title": "ContentApproval",
      "description": "Administrative governance item for reviewing published articles and regimens.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetType": { "type": "string", "enum": ["article", "regimen"] },
        "targetId": { "type": "string" },
        "title": { "type": "string" },
        "submittedByAuthorId": { "type": "string" },
        "submittedByAuthorName": { "type": "string" },
        "discipline": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending Review", "Approved", "Revision Requested"] },
        "reviewNotes": { "type": "string", "maxLength": 500 },
        "submittedAt": { "type": "string" },
        "reviewedByAdminId": { "type": "string" }
      },
      "required": ["id", "targetId", "submittedByAuthorId", "status", "submittedAt"]
    },
    "ClientProfile": {
      "title": "ClientProfile",
      "description": "Practitioner-facing client profile summary isolating non-sensitive clinical tracking info.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "clientName": { "type": "string" },
        "primaryGoal": { "type": "string" },
        "enrolledProgram": { "type": "string" },
        "discipline": { "type": "string" },
        "adherenceRate": { "type": "number" },
        "assessmentCompleted": { "type": "boolean" },
        "practitionerNotes": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Needs Review", "On Track"] },
        "assignedPractitionerId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "clientName", "assignedPractitionerId", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile with role definition. Restricted to owner read/update; role cannot be self-modified."
    },
    "/clientProfiles/{userId}": {
      "schema": { "$ref": "#/entities/ClientProfile" },
      "description": "Practitioner-facing limited profile. Readable by owner, admin, or assigned practitioner."
    },
    "/assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/LifestyleAssessment" },
      "description": "Lifestyle habits assessment. Accessible only to owning seeker, assigned practitioner, or platform admin."
    },
    "/dailyActivities/{activityId}": {
      "schema": { "$ref": "#/entities/DailyActivityLog" },
      "description": "Daily self-care habit records. Only readable and writable by owning seeker or assigned practitioner."
    },
    "/wellnessPrograms/{programId}": {
      "schema": { "$ref": "#/entities/WellnessProgram" },
      "description": "Wellness regimens. Public read if isPublished == true; writable only by verified practitioners."
    },
    "/educationalArticles/{articleId}": {
      "schema": { "$ref": "#/entities/EducationalArticle" },
      "description": "Peer-reviewed articles. Public read if status == 'published'; author can update drafts; admin approves."
    },
    "/practitioners/{practitionerId}": {
      "schema": { "$ref": "#/entities/PractitionerProfile" },
      "description": "Verified physician credential profile. Public read for certified doctors; verification controlled by admin."
    },
    "/consultations/{consultationId}": {
      "schema": { "$ref": "#/entities/ConsultationRequest" },
      "description": "Private consultations. Accessible exclusively to requesting seeker and assigned doctor."
    },
    "/contentApprovals/{approvalId}": {
      "schema": { "$ref": "#/entities/ContentApproval" },
      "description": "Governance review queue. Readable by submitting authors; reviewed exclusively by platform administrators."
    }
  }
}
